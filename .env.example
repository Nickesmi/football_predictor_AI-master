# Football Predictor AI - Environment Variables
# ==============================================

# API-Football Key (required)
# Get a free key at: https://www.api-football.com/
# Or via RapidAPI: https://rapidapi.com/api-sports/api/api-football
APIFOOTBALL_API_KEY=your_api_key_here

# API Host (optional - defaults to api-sports.io direct)
# For RapidAPI: APIFOOTBALL_HOST=api-football-v1.p.rapidapi.com
APIFOOTBALL_HOST=v3.football.api-sports.io

# Rate limiting (requests per minute)
API_RATE_LIMIT_PER_MINUTE=10

# Cache TTL in seconds (default: 6 hours)
CACHE_TTL_SECONDS=21600

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── The Odds API (for real bookmaker odds) ──
# Free tier: 500 requests/month
# Get a key at: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# ── Security ──
# APP_ENV: development (default) | production. Outside development the API
# refuses to start unless ADMIN_API_KEY and CORS_ALLOW_ORIGINS are set.
APP_ENV=development
# Admin endpoints (/api/debug/*, /api/admin/*) are disabled while this is empty.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
# Comma-separated browser origins allowed to call the API directly ('*' is rejected).
# Development default: http://localhost:5173 and http://127.0.0.1:5173 (plus WEB_PORT).
CORS_ALLOW_ORIGINS=
