# __ROOT__/etc/shadow.env (mode 0600). No secrets here; the key goes in api_key.env (mode 0600).
API_FOOTBALL_LEDGER=__ROOT__/run/api_football_ledger.db
API_FOOTBALL_REQUIRE_LEDGER=1
ODDS_REQUEST_BUDGET_API_FOOTBALL=70
ODDS_MIN_REMAINING=20
ODDS_MAX_AGE_MINUTES=240
APP_ENV=production
FOOTBALL_PREDICTOR_DB_PATH=__ROOT__/run/engine_shadow.db
FOOTBALL_PREDICTOR_CACHE_DIR=__ROOT__/run/workspace/.cache
TZ=UTC
# Never set for the shadow: PROBABILITY_INPUTS, BASELINE_FREEZE, FOOTBALL_SERVICE_HOLD_RELEASE
