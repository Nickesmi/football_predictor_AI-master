# M3.5 template — NOT installed. Install only after owner authorization (docs/M3_5_HOST_RUNBOOK.md §6).
[Unit]
Description=Football predictor forward shadow cycle (Medium, observations only)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
ConditionPathExists=!/srv/shadow/SHADOW_STOP

[Service]
Type=oneshot
User=shadow
Group=shadow
WorkingDirectory=/srv/shadow
EnvironmentFile=/etc/football-shadow/shadow.env
EnvironmentFile=/etc/football-shadow/api_key.env
Environment=API_FOOTBALL_CONSUMER=shadow_cycle
ExecStart=/opt/football-shadow/.venv/bin/python /opt/football-shadow/scripts/shadow_cycle.py \
  --db /srv/shadow/engine_shadow.db --ledger /srv/shadow/api_football_ledger.db \
  --manifest /srv/shadow/shadow_manifest.v4.json \
  --profile medium --max-requests-per-cycle 20 --budget 70
StandardOutput=append:/srv/shadow/logs/cycles.jsonl
StandardError=append:/srv/shadow/logs/cycles.err
TimeoutStartSec=25min
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/shadow
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1500M
UMask=0027
