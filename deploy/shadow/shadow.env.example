# /etc/football-shadow/shadow.env  (root:shadow, mode 0640). No secrets here; the key goes in api_key.env.
API_FOOTBALL_LEDGER=/srv/shadow/api_football_ledger.db
API_FOOTBALL_REQUIRE_LEDGER=1
ODDS_REQUEST_BUDGET_API_FOOTBALL=70
ODDS_MIN_REMAINING=20
ODDS_MAX_AGE_MINUTES=240
APP_ENV=production
FOOTBALL_PREDICTOR_DB_PATH=/srv/shadow/engine_shadow.db
FOOTBALL_PREDICTOR_CACHE_DIR=/srv/shadow/workspace/.cache
TZ=UTC
# Never set on the shadow host: PROBABILITY_INPUTS, BASELINE_FREEZE, FOOTBALL_SERVICE_HOLD_RELEASE
